###############################
# Server
###############################
PORT=4000
SERVER_ENV=development
SERVER_URL=http://localhost:4000

###############################
# Database (MongoDB)
###############################
# Local: mongodb://127.0.0.1:27017/momento
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
DATABASE_CONNECTION_STRING=mongodb://127.0.0.1:27017/momento

###############################
# Session & CORS
###############################
# Secret for express-session; use a strong random value in production
SESSION_SECRET=your_session_secret_here
# Frontend origin (CORS, cookies); must match frontend URL
CLIENT_URL=http://localhost:3000

###############################
# External APIs
###############################
# Unsplash API key (explore, details, external reviews)
# Get one at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

###############################
# Momento AI (OpenRouter)
###############################
# Required for in-app AI chat (captions, post ideas, etc.)
# Get one at https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key
